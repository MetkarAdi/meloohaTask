# Optional Groq API key rotation. The app starts without these keys.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-20b
# Provider request timeout (seconds); Groq uses key rotation, Gemini uses bounded transient retries.
GROQ_TIMEOUT_SECONDS=20
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_TRANSIENT_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=0.25
# Only needed for a custom model without published pricing in the LLM module.
GROQ_INPUT_PRICE_PER_MILLION=
GROQ_OUTPUT_PRICE_PER_MILLION=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Neon PostgreSQL URLs. Use the pooled URL for app queries and direct URL for Alembic migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required for registration and login. Generate a private 32+ character value.
JWT_SECRET=
ADMIN_SECRET=replace-with-a-long-random-admin-secret
APP_ENV=development
COOKIE_SECURE=false

# Public URL used by the browser to reach FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API configuration
API_HOST=127.0.0.1
API_PORT=8000
